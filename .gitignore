# Dépendances npm (outillage de dev uniquement — le livrable reste ganttPro.html)
node_modules/

# Fichiers temporaires et locaux
*.tmp
*~
.DS_Store
Thumbs.db

# Réglages locaux Claude Code (permissions spécifiques à la machine)
.claude/settings.local.json

# Fichiers temporaires LibreOffice/Word
~$*.docx

# Spécification au format Word : artefact généré par `npm run spec:docx` depuis
# docs/spec-fonctionnelle.md (la source de vérité, elle versionnée). Un binaire
# regénéré à chaque édition n'a rien à faire dans l'historique.
docs/*.docx
